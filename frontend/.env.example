# Copy to .env for local use (git-ignored). Read by vite.config.ts only; never injected into the browser bundle.
#
# Backend that `npm run dev` and `npm run preview` forward /health (and any path listed in backend-proxy.ts) to.
# Must be an http(s) URL on this computer (127.0.0.1, localhost or [::1]) because the proxy forwards the access token.
# Default when unset: http://127.0.0.1:8765, the address the backend listens on when PAI_HOST and PAI_PORT are unset.
# Set this when the backend runs with a different PAI_PORT.
# PAI_BACKEND_URL=http://127.0.0.1:8765
