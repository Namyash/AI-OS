#!/bin/sh
# Runs inside the image chroot at build time: arm the unattended installer and the installed-mode self-check facts.
#
# Both units are conditioned on the kernel command line (pai.install=auto and pai.selfcheck=1 respectively), so enabling
# them changes nothing on a normal boot or on a self-check boot of a live session beyond one unit skipped. The self-check
# unit's account (pai-selfcheck) is created by the hook of os/systemd. File modes are set for every file by
# os/build/assemble-config.sh (the scripts are 0755 because they start with #!, the units 0644).
set -e
systemctl enable pai-install-auto.service pai-selfcheck-crypt.service
