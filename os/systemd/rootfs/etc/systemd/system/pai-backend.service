# Private AI OS backend: the loopback-only HTTP API that the kiosk UI talks to.
# Accounts: /usr/lib/sysusers.d/pai.conf. Code: /opt/pai, root-owned and read-only to this service (installed by
# the image installer step). tests/security/test_systemd_units.py holds every unit in the image to one baseline.
[Unit]
Description=Private AI OS backend

[Service]
Type=exec
User=pai
Group=pai
WorkingDirectory=/opt/pai
# -s: do not load the per-user site directory. HOME is /var/lib/pai, the service's own writable state, so without it
# any *.pth file or usercustomize.py written there would run inside the service at every start, whatever protects /opt/pai.
ExecStart=/usr/bin/python3 -s -m backend
Environment=PYTHONDONTWRITEBYTECODE=1
SyslogIdentifier=pai-backend
Restart=on-failure
RestartSec=2
# 77 = refused to run as root, 78 = invalid configuration (backend/core/exit_codes.py): a restart cannot fix either.
RestartPreventExitStatus=77 78

# State survives reboots (/var/lib/pai, on the encrypted volume) and is private to the service account (0700): the
# kiosk user shares the group only to read the token, so it must not be able to list or enter the data. The runtime
# directory holds the per-start bearer token (/run/pai/token) and the endpoint file (/run/pai/endpoint, the URL the
# service listens on) and nothing else; its group access (0750) is what lets the kiosk user reach them. Both
# defaults match backend/core/config.py. Every file the service creates is private (UMask 0077) except those two,
# which the backend sets to 0640 itself.
StateDirectory=pai
StateDirectoryMode=0700
RuntimeDirectory=pai
RuntimeDirectoryMode=0750
UMask=0077
LimitCORE=0

# Sandbox
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# strict makes the whole file system read-only to the service, not hidden: that is how it reads the UI it serves
# (/opt/pai/frontend, PAI_STATIC_DIR) and nothing else is opened up for it. The UI directory must never be writable.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# The API listens on loopback and talks to local sockets only; nothing may leave the machine from here.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
